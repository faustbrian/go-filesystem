      "purpose": "`filesystem` is a capability-based, streaming filesystem abstraction for Go. It supports local files, deterministic in-memory storage, Amazon S3, Cloudflare R2, SFTP, and FTP without claiming that those backends provide the same guarantees.",
      "lifecycle": "stable",
      "kind": "public library",
      "releasable": true,
      "family": "integration-and-data-movement",
      "family_label": "Integration And Data Movement",
      "family_description": "Bounded external I/O, data movement, provider boundaries, and derived search state.",
      "family_order": 7,
      "cohesion": {
        "family": "integration-and-data-movement",
        "secondary_capabilities": [
